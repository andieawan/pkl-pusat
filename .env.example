APP_NAME="PKL SMKS Islam Bustanul Ulum"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pkl_pusat
DB_USERNAME=pkl_pusat
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Aktifkan (true) bila dibuka lewat HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Penyambungan ke Pusat Sekolah (lihat docs/PASANG-PKL.md). Bawaan: mati. ---
PUSAT_ENABLED=false
PUSAT_URL=
PUSAT_CLIENT_ID=
PUSAT_CLIENT_SECRET=
PUSAT_WEBHOOK_SECRET=
# Hanya uji lokal dgn sertifikat buatan sendiri (cURL error 60): isi PUSAT_CA_BUNDLE=C:\path\rootCA.pem, atau PUSAT_VERIFY_SSL=false
#PUSAT_CA_BUNDLE=
#PUSAT_VERIFY_SSL=true
# Di belakang NPMplus/Cloudflare, isi IP proxy (atau *) agar https terbaca
TRUSTED_PROXIES=
PUSAT_SINKRON_OTOMATIS=false
# APP_FORCE_HTTPS=true

# --- Aplikasi PKL ---
SCHOOL_NAME="SMKS Islam Bustanul Ulum Pakusari"
# Singkatan sekolah pada nomor surat keluar: 001/KET/SMKIBU/X/2026
KODE_SURAT=SMKIBU
# Login password untuk admin lokal darurat (buat dengan: php artisan pkl:buat-admin <username>)
TU_LOGIN_LOKAL=true

# --- Kop surat (bawaan sama dengan BK/TU) ---
#SURAT_KEPSEK="MUHAMMAD MUSLIM, S.Pd., Gr"
#SURAT_KOTA=Pakusari

# --- Sambungan ke aplikasi lain (lihat docs/SAMBUNGAN.md) ---
# Kunci API untuk BK membaca rekap PKL (isi juga PKL_API_KEY yang sama di .env BK). Buat: openssl rand -hex 32
PKL_API_KUNCI_BK=
PKL_BATAS_PERHATIAN=3
# Nomor surat dari register Surat Keluar TU (kunci = salah satu TU_API_KUNCI_PKL di .env TU)
TU_URL=
TU_API_KEY=
# Daftar mitra DUDI untuk Website (nama, bidang, jumlah siswa; tanpa data siswa)
PKL_MITRA_PUBLIK=true
